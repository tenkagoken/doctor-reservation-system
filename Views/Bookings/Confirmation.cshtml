@model Appointment
@{ ViewData["Title"] = "Reservation confirmed"; }
<section class="result-panel"><div class="result-icon">✓</div><div class="eyebrow small">RESERVATION CONFIRMED</div><h2>You’re all set<span class="accent">.</span></h2><p>Your appointment with <strong>@Model.Doctor.Name</strong> is confirmed for <strong>@Model.StartsAt.ToString("dddd, dd MMMM yyyy") at @Model.StartsAt.ToString("h:mm tt")</strong>.</p><div class="reference">Booking reference <strong>#@Model.Id.ToString("D6")</strong></div><a class="hero-button" asp-controller="Home" asp-action="Index">Back to home ↗</a></section>
