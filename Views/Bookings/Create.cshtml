@model BookingInput
@{ var slot = (Appointment)ViewBag.Appointment; ViewData["Title"] = "Complete your reservation"; }
<div class="back-row"><a asp-controller="Doctors" asp-action="Details" asp-route-id="@slot.DoctorId">← Back to available times</a></div>
<div class="booking-layout"><div><div class="eyebrow small"><span class="eyebrow-line"></span> ALMOST THERE</div><h2>Your appointment,<br /><em>made simple.</em></h2><p>Just enter your details to reserve this time. A confirmation will appear when your booking is complete.</p><div class="booking-summary"><span class="summary-label">YOUR VISIT</span><strong>@slot.Doctor.Name</strong><span>@slot.Doctor.Specialization</span><div class="summary-rule"></div><span>@slot.StartsAt.ToString("dddd, dd MMMM yyyy")</span><strong>@slot.StartsAt.ToString("h:mm tt") – @slot.EndsAt.ToString("h:mm tt")</strong></div></div>
<form class="booking-form" asp-controller="Bookings" asp-action="Create" asp-route-id="@slot.Id" method="post"><h3>Your details</h3><p>Fields marked * are required.</p><input asp-for="AppointmentId" type="hidden" /><label asp-for="Name">Full name *</label><input asp-for="Name" autocomplete="name" placeholder="Enter your full name" /><span class="field-error" asp-validation-for="Name"></span><label asp-for="NationalId">National ID number *</label><input asp-for="NationalId" inputmode="numeric" maxlength="14" pattern="[0-9]{14}" placeholder="14-digit national ID" /><span class="field-error" asp-validation-for="NationalId"></span><button type="submit">Confirm reservation <span>↗</span></button><small>Your information is used only for this reservation.</small></form></div>
